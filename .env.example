# ============================================================
# 复制本文件为 .env 后填写。.env 已在 .gitignore 里，不会被提交。
# ============================================================

# ---------- 对话模型 ----------
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# ---------- 向量模型（二选一，推荐硅基流动） ----------
# 【推荐】硅基流动 https://cloud.siliconflow.cn —— BAAI/bge-m3 免费用，需实名认证
SILICONFLOW_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# 【备选】智谱 https://bigmodel.cn —— embedding-3（付费，按量计费）
# ZHIPU_API_KEY=
# EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBED_MODEL=embedding-3

# 也可以直接用通用字段覆盖上面两家
# EMBED_API_KEY=

# ---------- 切分参数 ----------
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=4

# 注意：换了 EMBED_MODEL 之后必须重新建索引，向量维度不同不能混用：
#   python main.py index
