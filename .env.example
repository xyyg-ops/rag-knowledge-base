# 复制成 .env 后填入你自己的 Key
# 对话模型（DeepSeek）https://platform.deepseek.com
DEEPSEEK_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# 向量模型（智谱 embedding-3）https://open.bigmodel.cn
ZHIPU_API_KEY=
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_MODEL=embedding-3

# 切分参数
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=4
